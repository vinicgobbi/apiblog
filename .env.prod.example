##############################
#    Autenticação JWT        #
##############################
JWT_SECRET=
JWT_TTL=120
JWT_REFRESH_TTL=43800

##############################
#   Documentação Swagger     #
##############################
L5_SWAGGER_GENERATE_ALWAYS=false
