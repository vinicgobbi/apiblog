##############################
#   Front-end e Admin        #
##############################
BLOG_TITLE="Blog"
BLOG_DESCRIPTION=""
FRONT_URL=http://localhost:4200
ADMIN_NAME="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=

##############################
#    Autenticação JWT        #
##############################
JWT_SECRET=
JWT_TTL=120
JWT_REFRESH_TTL=43800

##############################
#   Documentação Swagger     #
##############################
L5_SWAGGER_GENERATE_ALWAYS=true
